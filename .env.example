# ========================= Environment Variables ========================
OPENAI_COMPATIBLE_API_KEY=
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
GOOGLE_GENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Legacy generic endpoint remains opt-in; individual agent settings control routing.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL_ID=gpt-4o-mini
OPENAI_COMPATIBLE_TEMPERATURE=0.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
HUGGING_FACE_HUB_TOKEN=

# Multiformat text extraction and speech transcription.
MAX_UPLOAD_BYTES=268435456
MAX_BATCH_FILES=32
MAX_BATCH_BYTES=1073741824
INDEX_ON_UPLOAD=false
MEDIA_TIMEOUT_SECONDS=180
VIDEO_MAX_DURATION_SECONDS=7200
AUDIO_CHUNK_SECONDS=300
WHISPER_MODEL=tiny
# Leave language blank for automatic detection; larger multilingual models improve accuracy.
WHISPER_LANGUAGE=
WHISPER_DEVICE=cpu
WHISPER_NO_SPEECH_THRESHOLD=0.6
# Configure an image-capable provider for PDF, DOCX and video. Users choose each upload's mode in Gradio.
VISION_PROVIDER=OLLAMA
VISION_MODEL=qwen3.5:2b
VISION_BASE_URL=http://127.0.0.1:11434
VISION_TIMEOUT_SECONDS=60
VLM_AUTOMATIC_MAX_VISUALS=4
VLM_MAX_VISUALS=32
VLM_MAX_CONCURRENCY=2
VLM_IMAGE_MAX_DIMENSION=1280
VIDEO_FRAME_INTERVAL_SECONDS=30
VIDEO_MAX_FRAMES=12
VIDEO_SCENE_SCAN_FPS=8
VIDEO_FRAME_MAX_DIMENSION=960
FFMPEG_BINARY=
FFPROBE_BINARY=
PDF_OCR_ENABLED=false
PDF_OCR_BACKEND=auto
OCR_BINARY=
PDF_OCR_LANGUAGE=eng
PDF_MAX_OCR_PAGES=20
LIBREOFFICE_BINARY=
DOCX_RENDER_ENABLED=true
DOCX_RENDER_TIMEOUT_SECONDS=45
INGESTION_CHECKPOINT_RETENTION_HOURS=24
SEMANTIC_CONTENT_CLASSIFICATION_ENABLED=true
COMBINED_SEMANTIC_DEDUP_ENABLED=true
COMBINED_DEDUP_ALLOW_PAID=false
COMBINED_DEDUP_SIMILARITY=0.94
COMBINED_DEDUP_MAX_RECORDS=512
COMBINED_DEDUP_MAX_COMPARISONS=16
COMBINED_DEDUP_TIMEOUT_SECONDS=15

# Gradio uses the existing HTTP API; provider keys stay on the backend.
FRONTEND_BACKEND_URL=http://127.0.0.1:8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=7860
FRONTEND_TIMEOUT_SECONDS=600
FRONTEND_UPLOAD_TIMEOUT_SECONDS=1800
FRONTEND_BROWSER_SECRET=
# ========================= LangSmith Config =========================
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="Wizora-AI"

# ========================= Question Generation Agent Config =========================
LLM_PROVIDER="NVIDIA_NIM"
# Verified working NVIDIA NIM instruction-tuned model for educational question generation
QUESTION_GENERATER_PROVIDER="NVIDIA_NIM"
QUESTION_GENERATER_MODEL_ID="nvidia/nemotron-3.5-bolt-e4b"
QUESTION_GENERATER_TEMPERATURE=0.7

# Optional question budgets. Blank preserves existing defaults; overall timeout
# can only tighten the existing frontend/graph deadline.
QUESTION_CANDIDATE_ATTEMPT_LIMIT=
QUESTION_BATCH_RETRY_LIMIT=
QUESTION_OVERALL_TIMEOUT_SECONDS=

QUESTION_REFINER_PROVIDER="NVIDIA_NIM"
QUESTION_REFINER_MODEL_ID="nvidia/nemotron-3.5-bolt-e4b"
QUESTION_REFINER_TEMPERATURE=0.2

QUESTION_REWRITER_PROVIDER="NVIDIA_NIM"
QUESTION_REWRITER_MODEL_ID="nvidia/nemotron-3.5-bolt-e4b"
QUESTION_REWRITER_TEMPERATURE=0.2
# ========================= Summarizer Agent Config =========================
SUMMARIZER_MAINPOINT_PROVIDER="GOOGLE_GENAI"
SUMMARIZER_MAINPOINT_MODEL_ID="gemini-3.5-flash-lite"
SUMMARIZER_MAINPOINT_TEMPERATURE=0.2

SUMMARIZER_WRITER_PROVIDER="GOOGLE_GENAI"
SUMMARIZER_WRITER_MODEL_ID="gemini-3.5-flash-lite"
SUMMARIZER_WRITER_TEMPERATURE=0.8

SUMMARIZER_REWRITER_PROVIDER="GOOGLE_GENAI"
SUMMARIZER_REWRITER_MODEL_ID="gemini-3.5-flash-lite"
SUMMARIZER_REWRITER_TEMPERATURE=0.2
# ==================== Question Answering Agent Config =========================
EMBEDDING_MODEL_PROVIDER="LOCAL_EMBEDDING" # LOCAL_EMBEDDING, HUGGINGFACE
EMBEDDING_MODEL_ID="sentence-transformers/all-MiniLM-L6-v2"
CHUNK_SIZE=350
CHUNK_OVERLAP=50
CHUNKING_STRATEGY="recursive"

GRADE_QA_PROVIDER="GOOGLE_GENAI"
GRADE_QA_MODEL_ID="gemini-3.5-flash-lite"
GRADE_QA_TEMPERATURE=0.0

QUESTION_ANSWERER_PROVIDER="GOOGLE_GENAI"
QUESTION_ANSWERER_MODEL_ID="gemini-3.5-flash-lite"
QUESTION_ANSWERER_TEMPERATURE=0.2

# ==================== Execution and History Budgets =========================
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_RETRY_MAX_WAIT_SECONDS=10
OLLAMA_API_KEY=
PROVIDER_PREFLIGHT_ENABLED=true
PROVIDER_PREFLIGHT_TIMEOUT_SECONDS=2
PROVIDER_FALLBACK_ENABLED=false
PROVIDER_FALLBACK_ALLOW_PAID=false
PROVIDER_FALLBACK_PROVIDER=
PROVIDER_FALLBACK_MODEL_ID=
OLLAMA_NUM_CTX=16384
GRAPH_TIMEOUT_SECONDS=180
QA_HISTORY_MESSAGES=12
QA_HISTORY_CHARACTERS=12000
QA_RETENTION_MESSAGES=40
QA_RETENTION_CHARACTERS=48000
REVISION_HISTORY_LIMIT=8
REVISION_HISTORY_CHARACTERS=12000
REVISION_CONTEXT_RECORDS=3
REVISION_CONTEXT_CHARACTERS=6000
REVISION_REQUIREMENTS_CHARACTERS=8000
AUTO_REVISION_LIMIT=1
REFINE_MODEL_CALL_LIMIT=3
GENERATION_CONTEXT_CHARACTERS=24000
GENERATION_CHUNK_CHARACTERS=12000
GENERATION_MAX_CHUNKS=64

# ==================== Durability and Operations =========================
# SQLite checkpoints are local to one server process. Do not set WEB_CONCURRENCY
# or UVICORN_WORKERS above 1. Chroma indexes and model clients stay in-process.
CHECKPOINT_DATABASE=runtime/checkpoints.sqlite
LOG_LEVEL=INFO
SESSION_RETENTION_DAYS=0
SESSION_LEASE_SECONDS=210

# ==================== Grounded Retrieval Budgets =========================
RAG_RETRIEVAL_STRATEGY="mmr"
RAG_TOP_K=5
RAG_FETCH_K=20
RAG_MIN_RELEVANCE=0
RAG_MMR_LAMBDA=0.5
RAG_MAX_EVIDENCE_DOCUMENTS=8
RAG_MAX_EVIDENCE_CHARACTERS=16000
RAG_NEAR_DUPLICATE_THRESHOLD=0.95
RAG_CONTEXT_WINDOW_TOKENS=16384
RAG_PROMPT_RESERVE_TOKENS=3000
RAG_OUTPUT_RESERVE_TOKENS=2048
RAG_MAX_EVIDENCE_TOKENS=7000
RAG_HISTORY_MESSAGES=6
RAG_HISTORY_CHARACTERS=2000
RAG_REWRITE_ENABLED=true
RAG_QUERY_MAX_CHARACTERS=1200
RAG_CORRECTIVE_PASSES=1
RAG_CORRECTIVE_TOP_K=10
RAG_CORRECTIVE_FETCH_K=40
